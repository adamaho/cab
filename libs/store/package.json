{
  "name": "@cab/store",
  "version": "0.0.0",
  "private": true,
  "description": "Event-sourced reactive store primitives for cab applications.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "clean": "rimraf node_modules dist build .turbo coverage tsconfig.tsbuildinfo",
    "lint": "oxlint --config ../../tools/oxlint-config/src/base.json src test vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts --passWithNoTests",
    "tsc": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "alien-signals": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@cab/tool-oxlint-config": "workspace:*",
    "@cab/tool-tsconfig": "workspace:*",
    "@effect/vitest": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
