{
  "name": "@cab/router-solid",
  "version": "0.0.0",
  "private": true,
  "description": "Solid adapter for the cab router.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "clean": "rimraf node_modules dist build .turbo coverage tsconfig.tsbuildinfo",
    "lint": "oxlint --config ../../tools/oxlint-config/src/base.json src test vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts --passWithNoTests",
    "tsc": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cab/router": "workspace:*",
    "@effect/atom-solid": "catalog:",
    "effect": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@cab/tool-oxlint-config": "workspace:*",
    "@cab/tool-tsconfig": "workspace:*",
    "@effect/vitest": "catalog:",
    "@solidjs/testing-library": "catalog:",
    "jsdom": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  }
}
